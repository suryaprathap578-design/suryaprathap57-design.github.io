# SUBHA INFRA - clean URLs (generated by _build/build.ps1; edit the build script, not this file)
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Never serve the build sources
RewriteRule ^_build(/|$) - [F,L]

# /any/folder/index.html  ->  /any/folder/
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Legacy .html pages -> clean URLs
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteRule ^careers\.html$ /careers/ [R=301,L]
RewriteRule ^contact\.html$ /contact/ [R=301,L]
RewriteRule ^faq\.html$ /faq/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^packages\.html$ /packages/ [R=301,L]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteRule ^process\.html$ /process/ [R=301,L]
RewriteRule ^projects\.html$ /projects/ [R=301,L]
RewriteRule ^quality\.html$ /quality/ [R=301,L]
RewriteRule ^service-architectural-design\.html$ /services/architectural-design/ [R=301,L]
RewriteRule ^service-design-and-build\.html$ /services/design-and-build/ [R=301,L]
RewriteRule ^service-facade-engineering\.html$ /services/facade-engineering/ [R=301,L]
RewriteRule ^service-interior-design\.html$ /services/interior-design/ [R=301,L]
RewriteRule ^service-peb-structures\.html$ /services/peb-structures/ [R=301,L]
RewriteRule ^service-steel-structures\.html$ /services/steel-structures/ [R=301,L]
RewriteRule ^service-structural-engineering\.html$ /services/structural-engineering/ [R=301,L]
RewriteRule ^service-tensile-structures\.html$ /services/tensile-structures/ [R=301,L]
RewriteRule ^services\.html$ /services/ [R=301,L]
RewriteRule ^sitemap\.html$ /sitemap/ [R=301,L]

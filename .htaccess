RewriteRule ^insight-tensile-structures-guide\.html$ / [R=301,L]
RewriteRule ^service-bhutan-projects\.html$ /services/ [R=301,L]

# Legacy asset paths
RewriteRule ^images/work/(.*)$ /assets/project-images/$1 [R=301,L]
RewriteRule ^images/interiors/(.*)$ /assets/service-images/interiors/$1 [R=301,L]
RewriteRule ^images/journey/(.*)$ /assets/service-images/journey/$1 [R=301,L]
RewriteRule ^images/brand/(.*)$ /assets/images/brand/$1 [R=301,L]
RewriteRule ^images/team/(.*)$ /assets/images/team/$1 [R=301,L]
RewriteRule ^style\.css$ /css/style.css [R=301,L]
RewriteRule ^main\.js$ /js/main.js [R=301,L]
RewriteRule ^site-config\.js$ /js/site-config.js [R=301,L]

# Any other *.html request -> extensionless folder URL (if that folder exists)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(jpg|jpeg|png|svg|webp|css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>